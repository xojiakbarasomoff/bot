# Repository-root ignores.
#
# Each project keeps its own .gitignore (instagram/.gitignore,
# telegram/.gitignore) — a .gitignore only covers the tree it sits in, so
# once both projects moved into subdirectories nothing was left guarding the
# root itself. This file covers what gets created *here*: a virtualenv or an
# env file made by someone working from the repository root rather than from
# inside one of the projects.

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env*.example

# Byte-compiled / cache
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
