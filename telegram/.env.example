# Application Configuration
APP_NAME="AI Medical Assistant"
APP_ENV="development"
DEBUG=True
PORT=8000

# ── Security ───────────────────────────────────────────────────────────────────
# Fernet key for encrypting channel credentials stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED — application will refuse to start if this is missing or empty.
ENCRYPTION_KEY="change_me_to_a_valid_fernet_key_32_bytes_base64"

# Telegram webhook secret token — passed to Telegram's setWebhook so only
# Telegram can call /api/v1/telegram/webhook/{tenant_id}.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to skip verification in development.
TELEGRAM_WEBHOOK_SECRET=""

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
# REQUIRED — no default password; the app will fail to start without this.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aimed_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# DATABASE_URL is assembled automatically from the above fields.
# You can override it here if you use an external managed database.
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/aimed_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/v1/telegram/webhook/1"
TELEGRAM_OPERATOR_CHANNEL_ID=""  # Optional Telegram Channel/Group ID (e.g. -1001234567890) for lead alerts

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcard in production).
# Example: "https://app.example.com,https://admin.example.com"
# Leave empty in development — localhost origins are allowed automatically.
CORS_ORIGINS=""
